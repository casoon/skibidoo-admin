{
  "name": "skibidoo-admin",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:docker": "astro build --config astro.config.docker.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "secretlint": "secretlint \"**/*\"",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@alpinejs/persist": "^3.15.11",
    "@astrojs/alpinejs": "^0.5.0",
    "@astrojs/check": "^0.9.8",
    "@astrojs/cloudflare": "^13.1.8",
    "@astrojs/node": "^10.0.4",
    "@tailwindcss/vite": "^4.2.2",
    "@trpc/client": "^11.16.0",
    "alpinejs": "^3.15.11",
    "astro": "^6.1.5",
    "superjson": "^2.2.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^11.6.0",
    "@skibidoo/core": "file:../skibidoo-core",
    "@types/alpinejs": "^3.13.10",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "secretlint": "^11.6.0",
    "simple-git-hooks": "^2.13.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "sh -c 'FILES=$(git diff --cached --name-only --diff-filter=ACMR); [ -z \"$FILES\" ] && exit 0; npx secretlint $FILES'"
  }
}
